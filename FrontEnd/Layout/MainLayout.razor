@inherits LayoutComponentBase
@inject IJSRuntime JS

<PageTitle>Charlie Pilkington</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://users.ox.ac.uk/~kebl9018" target="_blank">Oxford Webpage</a>
            <button class="theme-toggle" type="button" @onclick="ToggleDarkMode" aria-label="Toggle dark mode" title="Toggle dark mode">
                <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-fill")" aria-hidden="true"></i>
            </button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isDarkMode;

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("document.body.classList.toggle", "dark-mode", isDarkMode);
    }
}
