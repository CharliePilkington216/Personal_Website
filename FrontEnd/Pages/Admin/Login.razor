@page "/admin/login"

<PageTitle>Admin Login</PageTitle>

<section class="admin-login">
	<h1>Admin login</h1>
	<p>Sign in to manage your portfolio.</p>

	@if (!string.IsNullOrEmpty(LoginError))
	{
		<p class="alert alert-danger" role="alert">@LoginError</p>
	}

	<EditForm Model="LoginRequest" OnValidSubmit="SubmitLogin">
		<DataAnnotationsValidator />
		<div class="form-field">
			<label for="admin-email">Email</label>
			<InputText id="admin-email" class="form-control" type="email" @bind-Value="LoginRequest.Email" autocomplete="username" />
			<ValidationMessage For="@(() => LoginRequest.Email)" />
		</div>

		<div class="form-field">
			<label for="admin-password">Password</label>
			<InputText id="admin-password" class="form-control" type="password" @bind-Value="LoginRequest.Password" autocomplete="current-password" />
			<ValidationMessage For="@(() => LoginRequest.Password)" />
		</div>

		<button class="btn btn-primary" type="submit" disabled="@IsLoggingIn">
			@if (IsLoggingIn)
			{
				<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
				<span>Signing in...</span>
			}
			else
			{
				<span>Log in</span>
			}
		</button>
	</EditForm>
</section>

@code {
	[Inject] private AuthServices AuthServices { get; set; } = default!;
	[Inject] private NavigationManager NavigationManager { get; set; } = default!;

	private LogInRequest LoginRequest { get; set; } = new();
	private string LoginError { get; set; } = "";
	private bool IsLoggingIn { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await AuthServices.Refresh();
			NavigationManager.NavigateTo("/admin/portfolio");
		}
		catch (HttpRequestException)
		{
		}
		catch (InvalidOperationException)
		{
		}
	}

	private async Task SubmitLogin()
	{
		if (IsLoggingIn)
		{
			return;
		}

		IsLoggingIn = true;
		LoginError = "";

		try
		{
			await AuthServices.Login(LoginRequest);
			NavigationManager.NavigateTo("/admin/portfolio");
		}
		catch (HttpRequestException)
		{
			LoginError = $"Login failed. Check your email and password.";
		}
		catch (InvalidOperationException)
		{
			LoginError = "Login failed. The server returned an invalid response.";
		}
		finally
		{
			IsLoggingIn = false;
		}
	}
}